      "id": "3c4f036e-ca28-4f16-aa95-440688beb046",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  let raw = item.json.shipment_data;\n\n  // Remove Markdown code fences if Gemini added them\n  raw = raw\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  let data;\n\n  try {\n    data = JSON.parse(raw);\n  } catch (error) {\n    return {\n      json: {\n        parse_success: false,\n        error: error.message,\n        raw_shipment_data: raw\n      }\n    };\n  }\n\n  // Normalize container number\n  if (data.container_number) {\n    data.container_number = data.container_number\n      .toUpperCase()\n      .replace(/[^A-Z0-9]/g, '');\n  }\n\n  return {\n    json: {\n      ...data,\n      parse_success: true\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -16
      ],
      "id": "3c2767cf-21ec-4ab0-bc1c-7db7b5159cd7",
