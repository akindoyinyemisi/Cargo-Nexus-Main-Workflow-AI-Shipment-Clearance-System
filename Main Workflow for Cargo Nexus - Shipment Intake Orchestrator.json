    {
      "parameters": {
        "jsCode": "// Get all shipment documents returned from PostgreSQL\nconst allDocs = $input.all().map(item => item.json);\n\n// Keep only the latest record for each document type\nconst uniqueByType = new Map();\n\nfor (const doc of allDocs) {\n  const type = String(doc.document_type || '')\n    .trim()\n    .toUpperCase();\n\n  if (!type) continue;\n\n  const existing = uniqueByType.get(type);\n\n  if (\n    !existing ||\n    Number(doc.id || 0) > Number(existing.id || 0)\n  ) {\n    uniqueByType.set(type, doc);\n  }\n}\n\nconst docs = Array.from(uniqueByType.values());\n\nconst documentTypes = docs.map(doc => doc.document_type);\n\n// Find Bill of Lading\nconst billOfLading = docs.find(\n  doc =>\n    String(doc.document_type || '')\n      .trim()\n      .toUpperCase() === 'BILL OF LADING'\n);\n\n// Find Container Manifest\nconst containerManifest = docs.find(\n  doc =>\n    String(doc.document_type || '')\n      .trim()\n      .toUpperCase() === 'CONTAINER MANIFEST'\n);\n\nconst discrepancies = [];\n\n// Check required documents\nif (!billOfLading) {\n  discrepancies.push({\n    field: 'document_type',\n    issue: 'Missing BILL OF LADING'\n  });\n}\n\nif (!containerManifest) {\n  discrepancies.push({\n    field: 'document_type',\n    issue: 'Missing CONTAINER MANIFEST'\n  });\n}\n\n// Fields to compare\nconst fieldsToCompare = [\n  'bill_of_lading_number',\n  'container_number',\n  'seal_number',\n  'shipper',\n  'consignee',\n  'carrier',\n  'vessel_name',\n  'voyage_number',\n  'port_of_loading',\n  'port_of_discharge',\n  'goods_description',\n  'package_count',\n  'gross_weight'\n];\n\n// Normalize general values\nfunction normalize(value) {\n  if (\n    value === null ||\n    value === undefined ||\n    value === ''\n  ) {\n    return null;\n  }\n\n  return String(value)\n    .trim()\n    .toUpperCase()\n    .replace(/\\s+/g, ' ');\n}\n\n// Normalize company names\n// Ignore address details and common company suffixes\nfunction normalizeCompany(value) {\n  return String(value)\n    .toUpperCase()\n    .split(',')[0]\n    .replace(/\\b(LIMITED|LTD|CO|COMPANY)\\b/g, '')\n    .replace(/[^A-Z0-9]/g, '')\n    .trim();\n}\n\n// Compare documents\nif (billOfLading && containerManifest) {\n\n  for (const field of fieldsToCompare) {\n\n    const bolValue = normalize(billOfLading[field]);\n\n    const manifestValue = normalize(\n      containerManifest[field]\n    );\n\n    // Both values missing\n    if (\n      bolValue === null &&\n      manifestValue === null\n    ) {\n      continue;\n    }\n\n    // One value missing\n    if (\n      bolValue === null ||\n      manifestValue === null\n    ) {\n      discrepancies.push({\n        field,\n        issue: 'Missing value in one document',\n        bill_of_lading:\n          billOfLading[field] ?? null,\n        container_manifest:\n          containerManifest[field] ?? null\n      });\n\n      continue;\n    }\n\n    // Special comparison for company names\n    const companyField =\n      field === 'shipper' ||\n      field === 'consignee';\n\n    const valuesMatch = companyField\n      ? normalizeCompany(bolValue) ===\n        normalizeCompany(manifestValue)\n      : bolValue === manifestValue;\n\n    // Record genuine discrepancies\n    if (!valuesMatch) {\n      discrepancies.push({\n        field,\n        issue: 'Value mismatch',\n        bill_of_lading: billOfLading[field],\n        container_manifest:\n          containerManifest[field]\n      });\n    }\n  }\n}\n\n// Return comparison results\nreturn [\n  {\n    json: {\n      container_number:\n        billOfLading?.container_number ||\n        containerManifest?.container_number ||\n        null,\n\n      documents_compared: documentTypes,\n\n      database_records_found: allDocs.length,\n\n      unique_documents_found: docs.length,\n\n      duplicate_records_ignored:\n        allDocs.length - docs.length,\n\n      required_documents_present: Boolean(\n        billOfLading && containerManifest\n      ),\n\n      discrepancy_count: discrepancies.length,\n\n      discrepancies,\n\n      comparison_status:\n        discrepancies.length === 0\n          ? 'MATCH'\n          : 'DISCREPANCY FOUND'\n    }\n  }\n];"
      },
