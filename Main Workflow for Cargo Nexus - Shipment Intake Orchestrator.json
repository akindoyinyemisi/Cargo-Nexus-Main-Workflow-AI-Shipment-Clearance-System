        "messages": {
          "values": [
            {
              "content": "=You are the document intelligence engine for Cargo Nexus.\n\nAnalyze the following extracted shipping document text:\n\n{{ $json.text }}\n\nExtract the shipment information and return ONLY valid JSON using this exact structure:\n\n{\n  \"document_type\": \"\",\n  \"bill_of_lading_number\": \"\",\n  \"booking_number\": \"\",\n  \"container_number\": \"\",\n  \"seal_number\": \"\",\n  \"shipper\": \"\",\n  \"consignee\": \"\",\n  \"carrier\": \"\",\n  \"vessel_name\": \"\",\n  \"voyage_number\": \"\",\n  \"port_of_loading\": \"\",\n  \"port_of_discharge\": \"\",\n  \"final_destination\": \"\",\n  \"goods_description\": \"\",\n  \"package_count\": \"\",\n  \"gross_weight\": \"\",\n  \"shipping_date\": \"\"\n}\n\nRules:\n- Use only information found in the document.\n- Do not invent missing information.\n- If a field is not present, return null.\n- Preserve container numbers, seal numbers, and document numbers exactly as written.\n- Return JSON only. Do not include explanations or markdown."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
